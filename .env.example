# ── Required ─────────────────────────────────────────────
# Your ShineMonitor / SmartClient login (used only on the server)
SHINE_USER=
SHINE_PASS=

# Login for your Helio dashboard (choose your own; 12+ characters)
DASH_USER=
DASH_PASSWORD=

# Random text that signs login sessions: `openssl rand -hex 32`
AUTH_SECRET=

# What you pay per unit (kWh) from the grid
TARIFF=8

# ── Optional ─────────────────────────────────────────────
# What the grid pays you per exported unit (0 = not applicable)
# EXPORT_TARIFF=2.25
# CURRENCY=₹
# LOCALE=en-IN
# TIMEZONE=Asia/Kolkata
# SHINE_PLANT_ID=            # only if your account has several plants
# SITE_LAT=                   # roof coordinates; default: the location saved on your plant
# SITE_LON=
# SYSTEM_KWP=                 # panel size in kWp; default: panels × watts from the datalogger
# GRID_VOLTAGE=230            # nominal grid voltage for the grid check
# GRID_FREQUENCY=50
# WEATHER=off                 # never call Open-Meteo (health then uses raw output only)

# Daily alert on Telegram (docs/alerts.md): the code from the Helio Solar bot, or your own bot
# TELEGRAM_LINK=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# CRON_SECRET=                # optional: openssl rand -hex 32
# ALERT_ONLY_ISSUES=true
# NEXT_PUBLIC_BRAND_NAME=Rishi Shah
# NEXT_PUBLIC_BRAND_URL=https://rishishah.in

